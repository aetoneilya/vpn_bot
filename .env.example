# Telegram bot token from BotFather
TELOXIDE_TOKEN=123456:ABCDEF

# Comma-separated Telegram user ids who approve requests and see admin commands (required)
APPROVER_USER_IDS=123456789
# If set, only these Telegram users may request access
ALLOW_USER_IDS=

# 3X-UI 3.x panel. Include the secret web base path, without /panel.
XUI_BASE_URL=http://127.0.0.1:2053/your-secret-path
# Either an API token...
XUI_API_TOKEN=
# ...or a panel login
XUI_USERNAME=admin
XUI_PASSWORD=change-me

# Inbounds every new client is attached to
XUI_INBOUND_IDS=1
# Public subscription base; the client's subId is appended
XUI_SUBSCRIPTION_BASE_URL=https://sub.example.com:2096/sub/
# VLESS flow: empty for XHTTP/gRPC inbounds, xtls-rprx-vision for raw TCP Reality
XUI_CLIENT_FLOW=
# Traffic limit per new client in GB, 0 = unlimited
XUI_TOTAL_GB=0

# Optional Telegram Mini App (leave WEB_PUBLIC_URL empty to disable). Telegram requires HTTPS,
# so terminate TLS in front of WEB_LISTEN.
WEB_PUBLIC_URL=
WEB_LISTEN=127.0.0.1:8080

# Optional health monitor of the relay chain (leave HEALTH_RELAY_ADDR empty to disable)
HEALTH_RELAY_ADDR=
HEALTH_SNIS=ign.com
HEALTH_SUBSCRIPTION_URL=
HEALTH_INTERVAL_SECS=300
HEALTH_FAIL_THRESHOLD=2

SQLITE_PATH=vpn_bot.sqlite3
